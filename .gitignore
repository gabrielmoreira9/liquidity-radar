# Credentials (keep only the credential-free example)
.env
.env.*
!.env.example
*.pem
*.key

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/

# OS and editor files
.DS_Store
.idea/
.vscode/

# Raw and historical datasets, including legacy nested data directories
**/data/raw/**
**/data/historical/**
!**/data/raw/**/
!**/data/historical/**/
!**/data/raw/**/.gitkeep
!**/data/raw/**/*.md
!**/data/raw/**/*.rst
!**/data/raw/**/README*.txt
!**/data/historical/**/.gitkeep
!**/data/historical/**/*.md
!**/data/historical/**/*.rst
!**/data/historical/**/README*.txt

# Processed datasets and generated artifacts (keep directory/docs versionable)
**/data/processed/**/*.csv
**/data/processed/**/*.parquet
**/data/processed/**/*.feather
**/data/processed/**/*.pkl
**/data/processed/**/*.pickle
**/data/processed/**/*.npz
**/data/processed/**/*.npy
**/data/processed/**/*.json
**/data/processed/**/*.jsonl
**/data/processed/audit/**
**/data/processed/risk_v2_runs/**
!**/data/processed/audit/**/
!**/data/processed/risk_v2_runs/**/
!**/data/processed/**/.gitkeep
!**/data/processed/**/*.md
!**/data/processed/**/*.rst
!**/data/processed/**/README*.txt

# Logs, checkpoints, caches and temporary execution/audit files
*.log
*.log.*
logs/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.cache/
cache/
.ipynb_checkpoints/
**/checkpoint*.json
**/*_checkpoint*.json
**/checkpoint*.lock
**/*_checkpoint*.lock
**/*.checkpoint
**/.audit_tmp*/
audit_tmp*/
run_tmp*/
execution_tmp*/
