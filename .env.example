# No Helius key is required by the API. This file contains no credentials.
# auto: full local processed datasets if present; otherwise the committed demo.
# A partial/invalid full dataset fails closed with HTTP 503, never silently falls back.
RADAR_DATA_MODE=auto
RADAR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RADAR_HISTORY_MAX_LIMIT=2000
# Optional absolute directory; default is this project's data/processed.
# RADAR_PROCESSED_DIR=/path/to/liquidity-radar/data/processed

# Frontend configuration (copy into Next.js .env.local)
NEXT_PUBLIC_RADAR_API_URL=http://127.0.0.1:8000
